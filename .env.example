# =============================================================================
# Persistent Memory Chatbot - configuration
# Copy to `.env` and fill in at least one API key.
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
# =============================================================================

# ----------------------------------------------------------------- LLM ------
# groq | gemini | openai | echo
# `echo` is a key-free offline mode: it does not generate text, it just reports
# what it recalled - useful for verifying the memory layer without an API key.
LLM_PROVIDER=groq

# Leave blank to use the provider default:
#   groq   -> llama-3.3-70b-versatile
#   gemini -> gemini-2.0-flash
#   openai -> gpt-4o-mini
LLM_MODEL=
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# --- API keys (only the selected provider's key is required) ---
# https://console.groq.com/keys           (free tier, fastest to get started)
GROQ_API_KEY=
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -------------------------------------------------------------- Memory ------
# sqlite -> built-in store, no extra services       (default, recommended)
# mem0   -> Mem0 OSS; needs `pip install -r requirements-mem0.txt`
#           AND an embedding key (OPENAI_API_KEY or GOOGLE_API_KEY)
MEMORY_BACKEND=sqlite

# How many memories to inject per turn, and the minimum relevance to qualify.
MEMORY_TOP_K=6
MEMORY_MIN_SCORE=0.05

# Use the LLM for fact extraction and conflict resolution.
# false = deterministic regex rules only (free, offline, lower recall).
MEMORY_EXTRACTION_ENABLED=true

# Recent turns replayed verbatim into the prompt (short-term window).
HISTORY_WINDOW=8

# ---------------------------------------------------------- Embeddings ------
# none | openai | gemini
# `none` keeps everything offline: recall uses the lexical scorer instead of
# vector similarity. Turn this on for better paraphrase matching.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=

# --------------------------------------------------------------- Paths ------
# Where memories and the transcript are written. Survives restarts.
DATA_DIR=./data
LOG_LEVEL=INFO
